# Server Configuration
PORT=5000
API_HOST=192.168.100.35
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/weapon-detection

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Signup OTP Configuration
SIGNUP_OTP_TTL_MINUTES=10
SIGNUP_OTP_MAX_ATTEMPTS=5
# Optional for local debugging only (never enable in production)
RETURN_OTP_IN_RESPONSE=false

# SMTP Email Configuration (required for OTP email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Weapon Detection <your-email@example.com>"

# RTSP Stream Configuration
RTSP_URL=rtsp://admin:password@192.168.1.64:554/Streaming/Channels/101

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
